# All local-dev env vars in one place. Copy to .env.local (gitignored) and
# fill in. Read by:
#   - Vite (client) — only VITE_* vars are exposed to the browser bundle
#   - npx supabase functions serve --env-file .env.local — Edge Function env

# --- Required for the client to talk to local Supabase ---
# Standard local Supabase URL + the demo anon key (printed by `npx supabase
# status`). Anon key is fixed across local installs and not a real secret.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# --- Optional: dev-only fake mode for the chat-message Edge Function ---
# When set to 1, the chat-message function skips the OpenRouter call and
# returns a canned Aozora-ruby reply after ~1.5s. Lets you exercise the full
# chat flow (composer, polling, word indexing, read tracking, corrections
# rendering) without configuring an OpenRouter key. Leave unset in prod.
OPENROUTER_FAKE_MODE=1

# --- Sentence TTS (generate-sentence-audio Edge Function) ---
# Azure Cognitive Services Speech credentials. When unset (and fake mode is
# off) the function returns 503 and the client hides its generate buttons;
# already-generated audio keeps playing.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# When set to 1, generate-sentence-audio skips Azure and uploads a short
# silent MP3 instead — upload, signed-URL, copy, card-stamp and playback
# paths are all exercisable without Azure credentials. Leave unset in prod.
AZURE_TTS_FAKE_MODE=1
